<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jasonzb.stephanie-bot-avatar</string>
    <!-- Runs every 6h; the script only rotates a bot once per AVATAR_INTERVAL_DAYS
         (default 7), so frequent runs just catch up after sleep/reboot. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jasonzb/.venvs/stephanie-avatar/bin/python</string>
        <string>/Users/jasonzb/bin/stephanie-bot-avatar.py</string>
    </array>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jasonzb/Library/Logs/stephanie-bot-avatar.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jasonzb/Library/Logs/stephanie-bot-avatar.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
