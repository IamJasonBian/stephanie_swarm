# Copy to services/mlx/.env (gitignored). Read by bin/swarm-svc-launcher.sh.
# MLX_MODEL=mlx-community/Qwen3.5-27B-6bit
# MLX_PORT=8321
# MLX_MAX_TOKENS=2048

# Concurrent decode slots (continuous batching). On a 48 GiB Mac the 27B 6-bit
# model measured ~32 tok/s aggregate with 4 slots vs ~8.6 tok/s with 1, at a
# ~24 GB peak once the KV cache is 4-bit. Keep dispatch's QWEN_CONCURRENCY equal.
MLX_MAX_SEQS=4
MLX_KV_BITS=4
