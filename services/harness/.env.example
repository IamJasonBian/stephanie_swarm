# Copy to .env (git-ignored). dev.sh loads it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
AGENT_MODEL=qwen3:8b
LLM_MODEL=qwen2.5:1.5b
# Sampling: higher = more random. Payload "temperature"/"top_p" override per job.
AGENT_TEMPERATURE=1.0
AGENT_TOP_P=0.95
# LLM_TEMPERATURE=0.8
# Final-answer length rule appended to the agent system prompt (empty = no limit).
# AGENT_ANSWER_STYLE=
# HARNESS_FS_ROOTS=~/Desktop
# HARNESS_API_KEY=
